<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none">
  <!-- Outer Gold Ring -->
  <circle cx="50" cy="50" r="46" stroke="#B69A70" stroke-width="2" opacity="0.85"/>
  <circle cx="50" cy="50" r="41" stroke="#B69A70" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
  
  <!-- Mau Narok Highland Contour / Mountain & Horizon -->
  <path d="M26 62 C34 50, 44 40, 50 40 C56 40, 66 50, 74 62" stroke="#B69A70" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M34 62 C40 54, 46 48, 50 48 C54 48, 60 54, 66 62" stroke="#B69A70" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>

  <!-- Morning Sun / Crest -->
  <circle cx="50" cy="31" r="5" fill="#B69A70"/>
  <line x1="50" y1="21" x2="50" y2="24" stroke="#B69A70" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="43" y1="24" x2="45" y2="26" stroke="#B69A70" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="57" y1="24" x2="55" y2="26" stroke="#B69A70" stroke-width="1.5" stroke-linecap="round"/>

  <!-- Base Baseline -->
  <line x1="24" y1="65" x2="76" y2="65" stroke="#B69A70" stroke-width="1.5" stroke-linecap="round"/>
  
  <!-- Monogram M -->
  <text x="50" y="79" font-family="'Cormorant Garamond', serif" font-size="14" font-weight="600" fill="#B69A70" text-anchor="middle" letter-spacing="2">M</text>
</svg>
